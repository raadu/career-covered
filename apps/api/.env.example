# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://career:secret@localhost:5432/career_covered"

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── AI — Groq API ────────────────────────────────────────────────────────────
# Required for cover letter generation. Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Optional — leave blank to disable Google login. App boots fine without these.
# Setup: https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Frontend URL (for OAuth redirect after login) ────────────────────────────
WEB_URL=http://localhost:5173
