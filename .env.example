# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://career:secret@localhost:5432/career_covered"

# Postgres container settings (used by docker-compose)
POSTGRES_USER=career
POSTGRES_PASSWORD=secret
POSTGRES_DB=career_covered

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@careercovered.dev
PGADMIN_PASSWORD=admin

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=career-covered
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ─── API (apps/api) ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# AI — Groq API key (required for cover letter generation)
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Shares the session cookie between the API's own host and the web app's
# host in production, since Google's OAuth callback lands the browser
# directly on the API (bypassing the Worker every other request goes
# through). Leave unset locally — api and web share "localhost" already,
# and a Domain that doesn't match the response host is rejected outright.
# COOKIE_DOMAIN=.careercovered.com

# ─── Web (apps/web) ───────────────────────────────────────────────────────────
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_LINKEDIN_URL=https://www.linkedin.com/in/raiyadraad
VITE_SUPPORT_FORM_URL=https://forms.gle/jC1UexnKXfP7yHVy9
